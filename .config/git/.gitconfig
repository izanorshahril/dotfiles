# Git Configuration - WSL2 Agentic Engineering
# Included by ~/.gitconfig from the WSL2 setup script.

[core]
    autocrlf = input
    safecrlf = warn
    excludesfile = ~/.config/git/.gitignore_global
    editor = nvim

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[diff]
    colorMoved = default

[merge]
    conflictstyle = zdiff3

[alias]
    # Status & Log
    st = status -sb
    co = checkout
    br = branch
    ci = commit
    last = log -1 HEAD --stat
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    
    # Worktree workflow for isolated agent branches
    wt = worktree
    wtl = worktree list
    wta = worktree add
    wtr = worktree remove
    wtp = worktree prune

    # Safety checks
    uncommit = reset --soft HEAD~1
    amend = commit --amend --no-edit
